{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mxtools",
  "version": "0.0.6",
  "identifier": "online.0w0.mxtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "萌新工具箱",
        "width": 1000,
        "height": 700,
        "minWidth": 980,
        "minHeight": 512,
        "decorations": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://*.bilibili.com https://*.bilivideo.com wss://*.bilibili.com",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.bilibili.com https://*.hdslb.com https://avatars.fastly.steamstatic.com https://*.akamaized.net https://cdn.vuetifyjs.com",
        "style-src": "'unsafe-inline' 'self'",
        "media-src": "'self' https://*.bilibili.com https://*.bilivideo.com https://*.hdslb.com blob:",
        "frame-src": "https://player.bilibili.com https://www.bilibili.com"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": [
        "file_capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    }
  }
}
