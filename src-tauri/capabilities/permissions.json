{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "file_capability",
  "description": "Capability for main and auxiliary windows",
  "windows": [
    "main",
    "about-window",
    "apex-quick-preset-window",
    "repair-store-window",
    "repair-onedrive-window",
    "repair-icon-cache-window",
    "repair-network-window",
    "repair-apex-launch-window",
    "apex-q-window",
    "apex-q-overlay-window"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$TEMP/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "steam://rungameid/*" },
        { "url": "steam://validate/*" },
        { "url": "steam://open/settings/downloads" },
        { "url": "steam://nav/console" },
        { "url": "steam://openurl/https://store.steampowered.com/app/2250040/Crosshair_V2/" },
        { "url": "ms-windows-store://pdp[?]productid=9ncndwxq7c66" },
        { "url": "ms-windows-store://pdp[?]productid=9nmfcl2gxn1c" }
      ]
    },
    "dialog:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:window:allow-set-focusable",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-always-on-top",
    "core:window:allow-get-all-windows",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-decorations",
    "core:window:allow-destroy",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size-constraints",
    "core:window:allow-set-effects",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-center",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:path:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:tray:default",
    "core:menu:default",
    "pinia:default"
  ],
  "platforms": [
    "windows"
  ]
}
