{
  "name": "mxtools",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && npm run bundle:report",
    "build:tauri": "npm run build && node scripts/prepare-tauri-dist.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "bundle:report": "node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri dev": "node scripts/tauri-dev.mjs",
    "build window": "tauri build",
    "build window release": "node scripts/build-windows-release.mjs",
    "release:size:check": "node scripts/release-size-budget.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-store/pinia": "^4.2.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "11",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^3.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "sass": "^1.92.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.5",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.1.10"
  }
}
